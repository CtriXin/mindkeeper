#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PATH="$SCRIPT_DIR:$PATH"

# Domain/service lookup is a bounded Stride Company entrypoint.
STRIDE_ROOT="${STRIDE_ROOT:-/Users/xin/stride}"
ENTRYPOINT="$STRIDE_ROOT/bin/lookup"

if [[ ! -x "$ENTRYPOINT" ]]; then
  echo "Error: Stride lookup entrypoint not found at $ENTRYPOINT" >&2
  exit 1
fi

exec "$ENTRYPOINT" "$@"
