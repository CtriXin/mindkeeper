#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PATH="$SCRIPT_DIR:$PATH"

# Run Service/Domain Lookup from anywhere.

LOOKUP_SCRIPT_PATH="$(runtime-component scmp_cli)"
LOOKUP_SCRIPT_PATH="${LOOKUP_SCRIPT_PATH%/scmp_cli.py}/service_lookup.py"

if [[ ! -f "$LOOKUP_SCRIPT_PATH" ]]; then
  echo "Error: Script not found at $LOOKUP_SCRIPT_PATH"
  exit 1
fi

exec python3 "$LOOKUP_SCRIPT_PATH" "$@"
