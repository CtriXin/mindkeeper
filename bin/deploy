#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PATH="$SCRIPT_DIR:$PATH"

# Stride owns default service inference and task-bound release execution.
STRIDE_ROOT="${STRIDE_ROOT:-/Users/xin/stride}"
ENTRYPOINT="$STRIDE_ROOT/bin/deploy"

if [[ ! -x "$ENTRYPOINT" ]]; then
  echo "Error: Stride deploy entrypoint not found at $ENTRYPOINT" >&2
  exit 1
fi

exec "$ENTRYPOINT" "$@"
