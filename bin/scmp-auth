#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PATH="$SCRIPT_DIR:$PATH"
STRIDE_ROOT="${STRIDE_ROOT:-/Users/xin/stride}"
ENTRYPOINT="$STRIDE_ROOT/bin/scmp-auth"

if [[ ! -x "$ENTRYPOINT" ]]; then
  echo "Error: Stride auth entrypoint not found at $ENTRYPOINT" >&2
  exit 1
fi

# Keep auth stdout untouched: it may contain a token.
exec "$ENTRYPOINT" "$@"
